# bmad-orchestrator — environment variables (spec §14.4)
# Copy to .env and chmod 600

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot (spec §15)
TELEGRAM_BOT_TOKEN=...
# Список chat_id whitelisted (запятая-separated)
# ORCHESTRATOR_TELEGRAM__CHAT_ID_WHITELIST=[123456789]

# Target project
ORCHESTRATOR_TARGET_PROJECT=/home/server/odyssey

# Budget caps (spec §8)
# ORCHESTRATOR_BUDGET__DAILY_LIMIT_USD=500
# ORCHESTRATOR_BUDGET__STORY_HALT_USD=50

# Parallelism — 3 как у BAD; на Tier 1 опустить до 2 если TPM hit
ORCHESTRATOR_MAX_PARALLEL_WORKERS=3

# BAD-compat aliases (опционально, дублирующие)
# MAX_PARALLEL_STORIES=3
# MODEL_STANDARD=claude-sonnet-4-6
# MODEL_QUALITY=claude-opus-4-7
# WORKTREE_BASE_PATH=/home/server

# Locale (spec §14.3)
ORCHESTRATOR_LOCALE=ru

# Voice STT (spec §15.8) — pluggable providers
# Опции: whisper_local | whisper_api | claude_audio | yandex_speechkit | google_stt_v2 | disabled
ORCHESTRATOR_VOICE__STT_PROVIDER=whisper_local
ORCHESTRATOR_VOICE__STT_MODEL=medium
ORCHESTRATOR_VOICE__STT_FALLBACK=whisper_local
ORCHESTRATOR_VOICE__LANGUAGE=ru
ORCHESTRATOR_VOICE__DELETE_AUDIO_AFTER_TRANSCRIPTION=true

# API keys для облачных voice providers (optional)
# ORCHESTRATOR_VOICE__OPENAI_API_KEY=sk-...
# ORCHESTRATOR_VOICE__YANDEX_API_KEY=...
# ORCHESTRATOR_VOICE__YANDEX_FOLDER_ID=...
# ORCHESTRATOR_VOICE__ELEVENLABS_API_KEY=...
# ORCHESTRATOR_VOICE__GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json
